DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: cambia la ruta del admin y declara el dominio HTTPS del panel.
DJANGO_ADMIN_PATH=admin
DJANGO_CSRF_TRUSTED_ORIGINS=
# Orígenes permitidos para el panel si se sirve desde otro dominio (sin comodines).
DJANGO_CORS_ORIGINS=
# SQLite local se mantiene por defecto. Al migrar, activa AGENDA_USE_POSTGRES=true
# y define DATABASE_URL, por ejemplo postgresql://agenda:password@localhost:5432/agenda
AGENDA_USE_POSTGRES=false
DATABASE_URL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@agenda.local
# Base absoluta del enlace público de reservas (/b/<slug>/) y de los logos
AGENDA_PUBLIC_BASE_URL=http://localhost:8000
# Detrás de un proxy (Render): confía en X-Forwarded-For y cuántos saltos son del proxy
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_TRUSTED_PROXY_COUNT=1
DJANGO_NUM_PROXIES=0
# Superadmin inicial para entornos nuevos; no modifica usuarios existentes
AGENDA_SUPERADMIN_EMAIL=
AGENDA_SUPERADMIN_PASSWORD=
AGENDA_SUPERADMIN_FIRST_NAME=
# Servir /media con Django cuando no hay servidor de archivos (solo demo)
AGENDA_SERVE_MEDIA=false
# Push: console en desarrollo; webhook/fcm requieren URL y token
AGENDA_PUSH_PROVIDER=console
AGENDA_PUSH_WEBHOOK_URL=
AGENDA_PUSH_TOKEN=
